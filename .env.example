SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

SERPER_API_KEY=your-serper-api-key

# Optional — add later when Claude + ElevenLabs integration begins
ANTHROPIC_API_KEY=your-claude-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Telegram — Bot API. Same token for BOTH delivery (deliverBriefs.js, outbound)
# and the signup bot (src/bot/telegramBot.js, inbound). Users /start the bot to
# register and manage their watchlist over chat. Run the bot with: npm run bot
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather     # create a bot via @BotFather

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

SERPER_API_KEY=your-serper-api-key

# Optional — add later when Claude + ElevenLabs integration begins
ANTHROPIC_API_KEY=your-claude-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# WhatsApp delivery — Meta WhatsApp Cloud API (stage 6)
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id        # from Meta → WhatsApp → API Setup
WHATSAPP_TEMPLATE_NAME=daily_brief                   # name of your APPROVED template
WHATSAPP_TEMPLATE_LANG=en                            # template language code (en, en_US, ...)
WHATSAPP_API_VERSION=v21.0                           # optional, Graph API version

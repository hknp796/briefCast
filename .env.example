SUPABASE_URL=https://your-project.supabase.co     # bare base URL — no /rest/v1, no trailing slash
SUPABASE_SERVICE_KEY=your-service-role-key         # service_role key, NOT the anon key

SERPER_API_KEY=your-serper-api-key

# Script generation AND audio — Google Gemini (free at aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Audio (TTS) — all optional. Default: Gemini TTS, same key as above.
# TTS_PROVIDER=gemini                              # or "elevenlabs" to switch back
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore                            # any Gemini prebuilt voice
# ELEVENLABS_API_KEY=your-elevenlabs-api-key       # only for TTS_PROVIDER=elevenlabs
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL         # "Sarah"

# Telegram — Bot API. The SAME token is used by both halves of the app: delivery
# (deliverBriefs.js, outbound, in the pipeline) and the signup bot (the Supabase
# Edge Function, inbound). Users /start the bot to manage their watchlist.
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather   # create a bot via @BotFather

# Python interpreter for the yfinance helper (fetch_prices.py).
# Local only: point at your venv, e.g. /Users/you/Desktop/briefcast/venv/bin/python3
# Unset in GitHub Actions on purpose — it falls back to the runner's python3.
PYTHON_PATH=/Users/you/Desktop/briefcast/venv/bin/python3

# ── Where these actually live in production ───────────────────────────────
# This file is for LOCAL runs of the pipeline (`npm run pipeline`). In production
# nothing reads a .env:
#   • pipeline → GitHub Actions secrets (Settings → Secrets and variables)
#   • bot      → `npx supabase secrets set TELEGRAM_BOT_TOKEN=... TELEGRAM_WEBHOOK_SECRET=...`
#     (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically)
#
# TELEGRAM_WEBHOOK_SECRET is a random A-Z a-z 0-9 _ - string (openssl rand -hex 32)
# shared between `setWebhook` and the Edge Function. It is NOT needed locally.

# Pre-launch cost guard. Comma-separated telegram_chat_ids; the pipeline serves
# ONLY these accounts. Leave EMPTY in real production to serve every active user.
# Exists because the bot marks every new signup is_active=true, so any stranger
# who runs /start spends free-tier API quota (Gemini TTS has a daily cap).
PIPELINE_USER_ALLOWLIST=

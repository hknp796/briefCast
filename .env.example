SUPABASE_URL=https://your-project.supabase.co     # bare base URL — no /rest/v1, no trailing slash
SUPABASE_SERVICE_KEY=your-service-role-key         # service_role key, NOT the anon key

SERPER_API_KEY=your-serper-api-key

# Script generation — Google Gemini 2.5 Flash (free at aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Audio (TTS) — ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL           # optional, defaults to "Sarah"

# Telegram — Bot API. Same token for BOTH delivery (deliverBriefs.js, outbound)
# and the signup bot (src/bot/telegramBot.js, inbound). Users /start the bot to
# register and manage their watchlist over chat.
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather   # create a bot via @BotFather

# Python interpreter for the yfinance helper (fetch_prices.py).
# Local: point at your venv, e.g. /Users/you/Desktop/briefcast/venv/bin/python3
# Railway (nixpacks.toml): set to /opt/venv/bin/python3
PYTHON_PATH=/opt/venv/bin/python3
